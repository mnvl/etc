[user]
	name = Manvel Avetisian
	email = manvel@manvel.ai
[core]
	# git runs the pager through a shell, so fall back to less where delta is
	# not packaged (Debian/Ubuntu) instead of printing "not found"
	pager = "if command -v delta >/dev/null; then delta; else less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Monokai Extended
[init]
	defaultBranch = master
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[fetch]
	prune = true
	pruneTags = true
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[commit]
	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[diff]
	algorithm = histogram
	colorMoved = default
	renames = true
[merge]
	conflictstyle = diff3
[help]
	autocorrect = prompt
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
