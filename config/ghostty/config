font-family = Iosevka
font-style = Medium
font-size = 18
bold-is-bright = true

theme = Monokai Remastered
background = #000000
palette = 0=#000000

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

working-directory = home
window-inherit-working-directory = false

# macos compatibility
macos-icon = glass
macos-option-as-alt = true
keybind = §=text:`
keybind = ±=text:~
keybind = super+f=unbind
# ghostty binds these to esc:b / esc:f by default, which eats tmux M-Left/M-Right
keybind = alt+left=unbind
keybind = alt+right=unbind

confirm-close-surface = false
copy-on-select = clipboard

# font-size is in points scaled by display dpi, and linux (96dpi base) draws a
# given size a third larger than macos (72dpi), so keep the per-machine size in
# an untracked "local" next to this file -- it wins, and is skipped if missing
config-file = ?local
