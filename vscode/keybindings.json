// VS Code is used both on Linux and Mac OS. We try our best to make it work similarly on both
// platforms while trying to incorporate Emacs-era muscle-memory keybindings:
// 1. generally, Meta = Ctrl+Shift, but in some exceptional cases Meta = Alt,
// 2. on Linux, we use keyd to make Meta act as Ctrl for the most important bindings,
// 3. Ctrl+x and Meta+X are both shortcuts for cut, so we moved all M-x Emacs bindings to Alt+X.

[
// basic posix-like editing
{
    "key": "alt+b",
    "command": "cursorWordLeft",
},

{
    "key": "alt+f",
    "command": "cursorWordRight",
},

{
    "key": "alt+d",
    "command": "deleteWordRight",
},

{
    "key": "alt+n",
    "command": "runCommands",
    "args": {
        "commands": [
            {
                "command": "editor.actions.findWithArgs",
                "args": {
                    "searchString": "^\\s*$",
                    "isRegex": true,
                    "matchWholeWord": false,
                    "isCaseSensitive": false
                }
            },
            {
                "command": "editor.action.nextMatchFindAction"
            },
            {
                "command": "closeFindWidget"
            }
        ]
    }
},

